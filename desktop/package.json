{
  "name": "dafeiyu-desktop",
  "version": "0.4.9",
  "private": true,
  "type": "module",
  "description": "大肥鱼桌面端 — 一个图标、一个窗口、后台自动带起全部服务",
  "main": "src/main/index.mjs",
